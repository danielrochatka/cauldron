# Cauldron configuration
# Copy this file to config.env and fill in your values.

# REQUIRED: Set a long random secret key for your installation.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Server settings
CAULDRON_PORT=8000
CAULDRON_HOST=localhost
CAULDRON_DEBUG=false
CAULDRON_WORKERS=2

# AI provider selection (fake = built-in demo, openai = OpenAI Responses API)
CAULDRON_AI_PROVIDER=fake

# Path to AI config file (created on first save, mode 0600)
# CAULDRON_AI_CONFIG_PATH=

# OpenAI credentials (required when CAULDRON_AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

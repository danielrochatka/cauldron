# Cauldron configuration
# Copy this file to config.env and fill in your values.

# REQUIRED: Set a long random secret key for your installation.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Server settings
CAULDRON_PORT=8000
CAULDRON_HOST=localhost
CAULDRON_DEBUG=false
CAULDRON_WORKERS=2

# AI provider (leave as "fake" to use the built-in demo AI)
# Set to a vendor package name for real AI (e.g. cauldron-ai-openai)
CAULDRON_AI_PROVIDER=fake

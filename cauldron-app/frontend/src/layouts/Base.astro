---
import Navigation from '../components/Navigation.astro';

interface NavItem {
  title: string;
  route: string;
  current?: boolean;
}
interface Props {
  title: string;
  seoTitle?: string;
  metaDescription?: string;
  robotsIndex?: boolean;
  robotsFollow?: boolean;
  canonicalUrl?: string;
  navItems?: NavItem[];
  isPreview?: boolean;
}
const {
  title,
  seoTitle,
  metaDescription,
  robotsIndex = true,
  robotsFollow = true,
  canonicalUrl,
  navItems = [],
  isPreview = false,
} = Astro.props;

const pageTitle = seoTitle || title || 'Cauldron';
const robots = [
  robotsIndex ? 'index' : 'noindex',
  robotsFollow ? 'follow' : 'nofollow',
].join(', ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="stylesheet" href="/theme.css" />
  </head>
  <body>
    {isPreview && (
      <div class="cauldron-preview-banner" role="alert" aria-live="polite">
        Preview — not published
      </div>
    )}
    <Navigation items={navItems} />
    <slot />
  </body>
</html>

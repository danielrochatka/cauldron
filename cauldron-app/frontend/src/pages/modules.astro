---
import Base from '../layouts/Base.astro';

const navItems = [
  { title: 'Home', route: '/' },
  { title: 'Modules', route: '/modules/', current: true },
];
---
<Base title="Modules" navItems={navItems}>
  <main>
    <h1>Cauldron Modules</h1>
    <p id="module-status">Loading modules&hellip;</p>
    <table id="module-table" hidden>
      <thead>
        <tr>
          <th>Slug</th>
          <th>Label</th>
          <th>Version</th>
          <th>Source</th>
          <th>Enabled</th>
          <th>State</th>
          <th>Errors</th>
        </tr>
      </thead>
      <tbody id="module-tbody"></tbody>
    </table>
    <p id="module-empty" hidden>No modules discovered.</p>
  </main>
</Base>

<script is:inline>
(function () {
  var API_URL = '/api/cauldron/modules/';

  function stateClass(state) {
    var ok = ['registered', 'ready'];
    var warn = ['discovered', 'disabled', 'unavailable'];
    if (ok.indexOf(state) !== -1) return 'state-ok';
    if (warn.indexOf(state) !== -1) return 'state-warn';
    return 'state-fail';
  }

  function esc(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  fetch(API_URL)
    .then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function (data) {
      var modules = data.modules || [];
      var status = document.getElementById('module-status');
      var table = document.getElementById('module-table');
      var tbody = document.getElementById('module-tbody');
      var empty = document.getElementById('module-empty');

      if (modules.length === 0) {
        status.hidden = true;
        empty.hidden = false;
        return;
      }

      var rows = modules.map(function (m) {
        var errors = (m.errors || []).map(function (e) {
          var msg = e.message || (e.exception_type ? e.exception_type + ' in ' + e.phase : e.phase);
          return '<li>' + esc(msg) + '</li>';
        });
        var errorCell = errors.length
          ? '<ul>' + errors.join('') + '</ul>'
          : '';
        return '<tr>'
          + '<td><code>' + esc(m.slug) + '</code></td>'
          + '<td>' + esc(m.label) + '</td>'
          + '<td>' + esc(m.version || '') + '</td>'
          + '<td>' + esc(m.source || '') + '</td>'
          + '<td>' + (m.enabled ? 'yes' : 'no') + '</td>'
          + '<td class="' + stateClass(m.state) + '">' + esc(m.state) + '</td>'
          + '<td>' + errorCell + '</td>'
          + '</tr>';
      });

      tbody.innerHTML = rows.join('');
      status.hidden = true;
      table.hidden = false;
    })
    .catch(function (err) {
      var status = document.getElementById('module-status');
      status.textContent = 'Failed to load modules: ' + err.message;
    });
}());
</script>

<style>
  table { border-collapse: collapse; width: 100%; }
  th, td { border: 1px solid #ccc; padding: 0.4em 0.8em; text-align: left; }
  th { background: #f4f4f4; }
  .state-ok { color: green; }
  .state-warn { color: #b86800; }
  .state-fail { color: red; font-weight: bold; }
  ul { margin: 0; padding-left: 1.2em; }
</style>

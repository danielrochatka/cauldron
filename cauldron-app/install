#!/usr/bin/env bash
# Cauldron idempotent installer — provisions all Python and frontend
# dependencies, initializes configuration, and verifies the installation.
# Safe to rerun at any time: existing configuration and content are preserved.
set -euo pipefail

CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$CAULDRON_DIR")"

source "$CAULDRON_DIR/lib.sh"

echo "==> Cauldron Installer"
echo ""

# ---------------------------------------------------------------------------
# 1. Validate prerequisites
# ---------------------------------------------------------------------------

# Python 3.11+
if ! command -v python3 &>/dev/null; then
  echo "ERROR: Python 3.11 or newer is required but python3 was not found in PATH." >&2
  echo "       Install from https://www.python.org/downloads/" >&2
  exit 1
fi
PYTHON_VERSION=$(python3 --version 2>&1 | awk '{print $2}')
PYTHON_MAJOR=$(echo "$PYTHON_VERSION" | cut -d. -f1)
PYTHON_MINOR=$(echo "$PYTHON_VERSION" | cut -d. -f2)
if [ "${PYTHON_MAJOR:-0}" -lt 3 ] || \
   { [ "${PYTHON_MAJOR:-0}" -eq 3 ] && [ "${PYTHON_MINOR:-0}" -lt 11 ]; }; then
  echo "ERROR: Python 3.11 or newer is required. Found: ${PYTHON_VERSION:-none}" >&2
  echo "       Install from https://www.python.org/downloads/" >&2
  exit 1
fi
echo "--> Python ${PYTHON_VERSION} OK"

# Node.js 18+
check_node_version 18

# npm
if ! command -v npm &>/dev/null; then
  echo "ERROR: npm is required but was not found in PATH." >&2
  echo "       npm is bundled with Node.js — reinstall from https://nodejs.org/" >&2
  exit 1
fi
NPM_VERSION=$(npm --version 2>/dev/null)
echo "--> npm ${NPM_VERSION} OK"

# frontend/package.json
if [ ! -f "$CAULDRON_DIR/frontend/package.json" ]; then
  echo "ERROR: frontend/package.json is missing." >&2
  echo "       This file must be present in the repository checkout." >&2
  echo "       Try: git checkout frontend/package.json" >&2
  exit 1
fi

# frontend/package-lock.json
if [ ! -f "$CAULDRON_DIR/frontend/package-lock.json" ]; then
  echo "ERROR: frontend/package-lock.json is missing." >&2
  echo "       This file must be tracked in the repository." >&2
  echo "       Try: git checkout frontend/package-lock.json" >&2
  exit 1
fi
echo "--> frontend/package.json and package-lock.json OK"

# ---------------------------------------------------------------------------
# 2. Install Python dependencies
# ---------------------------------------------------------------------------

if [ ! -d "$CAULDRON_DIR/.venv" ]; then
  echo "--> Creating virtual environment..."
  python3 -m venv "$CAULDRON_DIR/.venv"
fi

echo "--> Installing Python dependencies..."
source "$CAULDRON_DIR/.venv/bin/activate"
install_python_projects "$REPO_DIR" "$CAULDRON_DIR/requirements.txt"

# ---------------------------------------------------------------------------
# 3. Initialize configuration
# ---------------------------------------------------------------------------

echo "--> Initializing configuration..."
initialize_config "$CAULDRON_DIR/config.env" "$CAULDRON_DIR/config.env.example"

set -a
source "$CAULDRON_DIR/config.env"
set +a

cd "$CAULDRON_DIR"

# ---------------------------------------------------------------------------
# 4. Install frontend dependencies
# ---------------------------------------------------------------------------

install_frontend "$CAULDRON_DIR"

# ---------------------------------------------------------------------------
# 5. Initialize Django
# ---------------------------------------------------------------------------

echo "--> Running database migrations..."
"$CAULDRON_DIR/manage" migrate --no-input

echo "--> Collecting static files..."
"$CAULDRON_DIR/manage" collectstatic --no-input --clear -v 0

echo "--> Initializing UI overrides..."
"$CAULDRON_DIR/manage" cauldron_ui_init 2>/dev/null || true

echo "--> Running system check..."
"$CAULDRON_DIR/manage" check

echo "--> Checking for missing migrations..."
"$CAULDRON_DIR/manage" makemigrations --check

# ---------------------------------------------------------------------------
# 6. Initialize public site
# ---------------------------------------------------------------------------

echo "--> Building public site..."
if ! "$CAULDRON_DIR/manage" cauldron_site_build; then
  echo "" >&2
  echo "ERROR: Public site build failed. The error output is above." >&2
  echo "       Existing generated output (if any) was preserved." >&2
  exit 1
fi

echo ""
echo "==> Installation complete."
echo ""
echo "Next steps:"
echo "  1. Create a superuser: ./manage createsuperuser"
echo "  2. Start the server:   ./start"
echo ""

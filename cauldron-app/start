#!/usr/bin/env bash
set -euo pipefail

CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"

source "$CAULDRON_DIR/lib.sh"

# 1. Verify installation is complete.
if ! is_installation_ready "$CAULDRON_DIR"; then
  echo "" >&2
  echo "ERROR: Cauldron is not fully installed. Run:" >&2
  echo "       ./install" >&2
  exit 1
fi

# 2. Activate the virtualenv.
source "$CAULDRON_DIR/.venv/bin/activate"

# 3. Load configuration.
set -a
source "$CAULDRON_DIR/config.env"
set +a

# 4. Start the server.
PORT="${CAULDRON_PORT:-8000}"
launch_server "$CAULDRON_DIR" "$PORT"

#!/usr/bin/env bash
set -euo pipefail

CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$CAULDRON_DIR")"

# 1. Check Python 3.11+
PYTHON_VERSION=$(python3 --version 2>&1 | awk '{print $2}')
PYTHON_MAJOR=$(echo "$PYTHON_VERSION" | cut -d. -f1)
PYTHON_MINOR=$(echo "$PYTHON_VERSION" | cut -d. -f2)

if [ -z "$PYTHON_VERSION" ] || [ "$PYTHON_MAJOR" -lt 3 ] || { [ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -lt 11 ]; }; then
  echo "ERROR: Python 3.11 or newer is required. Found: ${PYTHON_VERSION:-none}"
  echo "Please install Python 3.11+ from https://www.python.org/downloads/"
  exit 1
fi

# 2. Create virtualenv if it doesn't exist
if [ ! -d "$CAULDRON_DIR/.venv" ]; then
  echo "--> Creating virtual environment..."
  python3 -m venv "$CAULDRON_DIR/.venv"
fi

# 3. Activate virtualenv
source "$CAULDRON_DIR/.venv/bin/activate"

# 4. Install/upgrade dependencies.
#    Only pip-install packages that have a pyproject.toml — this skips
#    non-Python packages such as cauldron-astro.
echo "--> Installing dependencies..."
pip install -q -r "$CAULDRON_DIR/requirements.txt"
for pkg in "$REPO_DIR"/packages/*; do
  [ -f "$pkg/pyproject.toml" ] || continue
  pip install -q -e "$pkg"
done

# 5. Load config.env
if [ -f "$CAULDRON_DIR/config.env" ]; then
  set -a
  source "$CAULDRON_DIR/config.env"
  set +a
fi

# 6. Require SECRET_KEY
if [ -z "${SECRET_KEY:-}" ]; then
  echo "ERROR: SECRET_KEY is not set in config.env."
  echo "       Generate one with:"
  echo "       python3 -c \"import secrets; print(secrets.token_hex(32))\""
  exit 1
fi

cd "$CAULDRON_DIR"

# 7. Run migrations
echo "--> Running database migrations..."
"$CAULDRON_DIR/manage" migrate --no-input

# 8. Collect static assets
echo "--> Collecting static files..."
"$CAULDRON_DIR/manage" collectstatic --no-input --clear -v 0

# 9. Initialize override directory
"$CAULDRON_DIR/manage" cauldron_ui_init 2>/dev/null || true

# 10. Start the server
PORT="${CAULDRON_PORT:-8000}"
PID_FILE="$CAULDRON_DIR/data/cauldron.pid"

if command -v gunicorn &>/dev/null; then
  gunicorn \
    --bind "0.0.0.0:$PORT" \
    --workers "${CAULDRON_WORKERS:-2}" \
    --pid "$PID_FILE" \
    --access-logfile "$CAULDRON_DIR/logs/access.log" \
    --error-logfile "$CAULDRON_DIR/logs/error.log" \
    --daemon \
    cauldron_site.wsgi:application
  echo "Cauldron started on http://localhost:$PORT (gunicorn)"
else
  echo "Cauldron starting on http://localhost:$PORT (press Ctrl+C to stop)"
  "$CAULDRON_DIR/manage" runserver "0.0.0.0:$PORT"
fi

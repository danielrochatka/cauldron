#!/usr/bin/env bash
set -euo pipefail
CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"
PID_FILE="$CAULDRON_DIR/data/cauldron.pid"

if [ ! -f "$PID_FILE" ]; then
  echo "No PID file found — Cauldron may not be running."
  exit 0
fi

PID=$(cat "$PID_FILE")
if ! kill -0 "$PID" 2>/dev/null; then
  echo "Process $PID is not running — removing stale PID file."
  rm -f "$PID_FILE"
  exit 0
fi

kill -TERM "$PID"

# Wait up to 30 seconds for workers to exit cleanly
WAITED=0
while kill -0 "$PID" 2>/dev/null; do
  if [ "$WAITED" -ge 30 ]; then
    echo "WARNING: Process $PID did not exit after 30 s — sending SIGKILL."
    kill -KILL "$PID" 2>/dev/null || true
    break
  fi
  sleep 1
  WAITED=$((WAITED + 1))
done

rm -f "$PID_FILE"
echo "Cauldron stopped (pid $PID)."

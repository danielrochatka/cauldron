#!/usr/bin/env bash
set -euo pipefail
CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"
PID_FILE="$CAULDRON_DIR/data/cauldron.pid"

if [ -f "$PID_FILE" ]; then
  PID=$(cat "$PID_FILE")
  if kill -0 "$PID" 2>/dev/null; then
    kill -TERM "$PID"
    echo "Cauldron stopped (pid $PID)."
  else
    echo "Process $PID is not running."
  fi
  rm -f "$PID_FILE"
else
  echo "No PID file found — Cauldron may not be running."
fi

#!/usr/bin/env bash
set -euo pipefail

CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$CAULDRON_DIR")"
VENV="$CAULDRON_DIR/.venv"

source "$CAULDRON_DIR/lib.sh"

echo "==> Cauldron Update"
echo ""

# Ensure config.env exists and has a stable SECRET_KEY before doing anything.
initialize_config "$CAULDRON_DIR/config.env" "$CAULDRON_DIR/config.env.example"

# Load configuration so $CAULDRON_PORT and $SECRET_KEY are available.
set -a
source "$CAULDRON_DIR/config.env"
set +a

PORT="${CAULDRON_PORT:-8000}"

# 1. Validate repository state before touching anything.
cd "$REPO_DIR"

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "ERROR: $REPO_DIR is not a Git repository."
  exit 1
fi

# Detect uncommitted local modifications to tracked files.
if ! git diff --quiet HEAD 2>/dev/null || ! git diff --cached --quiet HEAD 2>/dev/null; then
  echo "ERROR: Tracked files have uncommitted local changes."
  echo "       Inspect changes with: git diff"
  echo "       Discard them with:    git checkout -- ."
  echo "       Or stash them with:   git stash  (then ./update, then git stash pop)"
  exit 1
fi

# Check whether the current branch has a configured upstream.
# If not, skip the git pull — the rest of the update (packages, migrations,
# server restart) still runs, which is useful after a manual branch switch.
HAS_UPSTREAM=1
if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' &>/dev/null; then
  echo "    NOTE: No upstream branch configured — skipping git pull."
  echo "          To pull updates, set one with:"
  echo "          git branch --set-upstream-to=origin/main main"
  HAS_UPSTREAM=0
fi

if [ "$HAS_UPSTREAM" -eq 1 ]; then
  # Verify the remote is reachable (avoids stopping the server before a network error).
  echo "--> Checking remote reachability..."
  if ! git fetch --dry-run origin &>/dev/null; then
    echo "ERROR: Cannot reach the remote repository. Check your network connection."
    exit 1
  fi
fi

# 2. Stop server and wait for all workers to exit.
if [ -f "$CAULDRON_DIR/data/cauldron.pid" ]; then
  echo "--> Stopping server..."
  "$CAULDRON_DIR/stop"
fi

# 3. Back up the database.
DB="$CAULDRON_DIR/data/cauldron.db"
BACKUP=""
if [ -f "$DB" ]; then
  BACKUP="$CAULDRON_DIR/data/cauldron.db.bak-$(date +%Y%m%d-%H%M%S)"
  cp "$DB" "$BACKUP"
  echo "--> Database backed up to $(basename "$BACKUP")"
fi

# 4. Record the current commit so rollback can return to it exactly.
PREV_COMMIT="$(git rev-parse HEAD)"
echo "--> Current commit: ${PREV_COMMIT:0:8}"

# Rollback: move HEAD back, restore DB, reinstall old packages, restart.
_rollback() {
  echo ""
  echo "!!! Update failed. Rolling back to ${PREV_COMMIT:0:8}..."

  # Stop any partially-started server.
  if [ -f "$CAULDRON_DIR/data/cauldron.pid" ]; then
    "$CAULDRON_DIR/stop" 2>/dev/null || true
  fi

  # Return HEAD and working tree to the previous commit.
  cd "$REPO_DIR"
  git reset --hard "$PREV_COMMIT" 2>/dev/null || true

  # Restore the database backup.
  if [ -n "${BACKUP:-}" ] && [ -f "$BACKUP" ]; then
    cp "$BACKUP" "$DB"
    echo "!!! Database restored from backup."
  fi

  # Reinstall packages from the restored commit and restart.
  source "$VENV/bin/activate"
  install_python_projects "$REPO_DIR" "$CAULDRON_DIR/requirements.txt"
  "$CAULDRON_DIR/start" 2>/dev/null || true

  echo ""
  echo "!!! Cauldron rolled back to commit ${PREV_COMMIT:0:8}."
  echo "!!! Fix the error above, then run ./update again."
}
trap '_rollback' ERR

# 5. Pull latest code (only when an upstream is configured).
if [ "$HAS_UPSTREAM" -eq 1 ]; then
  echo "--> Pulling latest Cauldron..."
  cd "$REPO_DIR"
  git pull --ff-only
else
  echo "--> Skipping git pull (no upstream configured)."
fi

# 6. Install/upgrade all Python packages and their dependencies.
echo "--> Upgrading dependencies..."
source "$VENV/bin/activate"
install_python_projects "$REPO_DIR" "$CAULDRON_DIR/requirements.txt"

# 7. Run migrations.
echo "--> Applying database migrations..."
"$CAULDRON_DIR/manage" migrate --no-input

# 8. Collect static assets.
echo "--> Collecting static assets..."
"$CAULDRON_DIR/manage" collectstatic --no-input --clear -v 0

# 9. Initialize override directory.
"$CAULDRON_DIR/manage" cauldron_ui_init 2>/dev/null || true

# 10. Install/upgrade frontend dependencies (always re-runs after a git pull
#     in case package-lock.json was updated).
install_frontend "$CAULDRON_DIR"

# 11. Rebuild public site.
#     A build failure does NOT roll back the Python/database updates — those
#     are safe to keep.  We record the outcome and report it at the end after
#     the server is confirmed healthy.
echo "--> Building public site..."
SITE_BUILD_OK=1
"$CAULDRON_DIR/manage" cauldron_site_build \
  2>&1 | tee -a "$CAULDRON_DIR/logs/site_build.log" || SITE_BUILD_OK=0
if [ "$SITE_BUILD_OK" -eq 0 ]; then
  echo ""
  echo "    WARNING: Public-site rebuild failed. Existing output was preserved."
  echo "             See: $CAULDRON_DIR/logs/site_build.log"
fi

# 12. Run system check.
echo "--> Running system check..."
"$CAULDRON_DIR/manage" check

# 13. Start server.
# Re-source lib.sh so any changes pulled in step 5 (e.g. new --timeout flag)
# take effect before the server is launched.  lib.sh was sourced at startup
# from the pre-pull version; re-sourcing here picks up the updated functions.
echo "--> Starting server..."
source "$CAULDRON_DIR/lib.sh"
PORT="${CAULDRON_PORT:-8000}"
launch_server "$CAULDRON_DIR" "$PORT"

# 14. Health check — verify the app and static files are reachable.
#     Triggers the ERR trap (and therefore rollback) on failure.
echo "--> Verifying server health..."
HEALTHY=0
for i in $(seq 1 20); do
  if curl -sf "http://localhost:$PORT/accounts/login/" -o /dev/null 2>/dev/null && \
     curl -sf "http://localhost:$PORT/static/cauldron_admin/css/tokens.css" -o /dev/null 2>/dev/null; then
    HEALTHY=1
    break
  fi
  sleep 1
done

if [ "$HEALTHY" -eq 0 ]; then
  echo "ERROR: Server did not respond on port $PORT after 20 seconds."
  false  # Triggers the ERR trap → _rollback
fi

trap - ERR

NEW_COMMIT="$(git -C "$REPO_DIR" rev-parse --short HEAD)"

# Report final status.  A site-build failure is surfaced here — after the
# server is confirmed healthy — so Python/database updates are kept.
if [ "$SITE_BUILD_OK" -eq 0 ]; then
  echo ""
  echo "==> Application updated; public-site rebuild failed."
  echo "    Retry:     ./manage cauldron_site_build"
  echo "    Build log: $CAULDRON_DIR/logs/site_build.log"
  echo "    ${PREV_COMMIT:0:8} -> $NEW_COMMIT"
  exit 1
fi

echo ""
echo "==> Cauldron updated successfully."
echo "    ${PREV_COMMIT:0:8} -> $NEW_COMMIT"

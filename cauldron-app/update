#!/usr/bin/env bash
set -euo pipefail

CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$CAULDRON_DIR")"
VENV="$CAULDRON_DIR/.venv"

source "$CAULDRON_DIR/lib.sh"

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

SKIP_PREFLIGHT=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-preflight)
      SKIP_PREFLIGHT=1
      shift
      ;;
    --help|-h)
      echo "Usage: ./update [--skip-preflight]"
      echo ""
      echo "  --skip-preflight  Skip the pre-update verification step."
      echo "                    WARNING: skipping preflight means the server may stop"
      echo "                    before a broken update is detected."
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      echo "       Run: $0 --help" >&2
      exit 2
      ;;
  esac
done

echo "==> Cauldron Update"
echo ""

# Ensure config.env exists and has a stable SECRET_KEY before doing anything.
initialize_config "$CAULDRON_DIR/config.env" "$CAULDRON_DIR/config.env.example"

# Load configuration so $CAULDRON_PORT and $SECRET_KEY are available.
set -a
source "$CAULDRON_DIR/config.env"
set +a

PORT="${CAULDRON_PORT:-8000}"

# ---------------------------------------------------------------------------
# 1. Validate repository state before touching anything.
# ---------------------------------------------------------------------------
cd "$REPO_DIR"

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "ERROR: $REPO_DIR is not a Git repository."
  exit 1
fi

# Detect uncommitted local modifications to tracked files.
if ! git diff --quiet HEAD 2>/dev/null || ! git diff --cached --quiet HEAD 2>/dev/null; then
  echo "ERROR: Tracked files have uncommitted local changes."
  echo "       Inspect changes with: git diff"
  echo "       Discard them with:    git checkout -- ."
  echo "       Or stash them with:   git stash  (then ./update, then git stash pop)"
  exit 1
fi

# ---------------------------------------------------------------------------
# 2. Fetch and resolve the candidate commit.
#    Resolves to an immutable SHA so the same commit is verified and installed.
# ---------------------------------------------------------------------------
HAS_UPSTREAM=1
if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' &>/dev/null; then
  echo "    NOTE: No upstream branch configured — skipping fetch."
  echo "          To pull updates, set one with:"
  echo "          git branch --set-upstream-to=origin/main main"
  HAS_UPSTREAM=0
fi

CANDIDATE_SHA=""

if [[ "$HAS_UPSTREAM" -eq 1 ]]; then
  echo "--> Fetching from remote..."
  if ! git fetch origin 2>&1; then
    echo "ERROR: Cannot reach the remote repository. Check your network connection."
    exit 1
  fi

  # Resolve the upstream tracking ref to an immutable commit SHA.
  UPSTREAM_REF="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}')"
  CANDIDATE_SHA="$(git rev-parse "${UPSTREAM_REF}^{commit}")"
  echo "    Candidate: ${CANDIDATE_SHA:0:8} (${UPSTREAM_REF})"

  # Verify the candidate is a valid fast-forward from HEAD.
  CURRENT_SHA="$(git rev-parse HEAD)"
  if [[ "$CURRENT_SHA" == "$CANDIDATE_SHA" ]]; then
    echo "    Already at ${CANDIDATE_SHA:0:8} — nothing to pull."
    echo ""
    echo "    Running verification and health check on the current installation..."
    echo ""
  elif ! git merge-base --is-ancestor "$CURRENT_SHA" "$CANDIDATE_SHA" 2>/dev/null; then
    echo "ERROR: Candidate ${CANDIDATE_SHA:0:8} is not a fast-forward from HEAD."
    echo "       The remote history may have diverged.  Inspect with:"
    echo "         git log --oneline HEAD..${UPSTREAM_REF}"
    exit 1
  fi
else
  # No upstream: verify the current HEAD without pulling.
  CANDIDATE_SHA="$(git rev-parse HEAD)"
  echo "    Verifying current HEAD: ${CANDIDATE_SHA:0:8}"
fi

# ---------------------------------------------------------------------------
# 3. Preflight verification — runs BEFORE stopping the server so that a broken
#    candidate is rejected while the live server continues serving requests.
# ---------------------------------------------------------------------------
if [[ "$SKIP_PREFLIGHT" -eq 1 ]]; then
  echo ""
  echo "    WARNING: Preflight verification skipped (--skip-preflight)."
  echo "             The server will be stopped before the update is verified."
  echo "             Use this flag only for emergency maintenance."
  echo ""
elif [[ -x "$CAULDRON_DIR/verify-update" ]]; then
  echo "--> Running preflight verification for ${CANDIDATE_SHA:0:8}..."
  if ! "$CAULDRON_DIR/verify-update" "$CANDIDATE_SHA"; then
    echo ""
    echo "ERROR: Preflight verification failed. The live server is still running."
    echo "       Fix the issue above and re-run ./update."
    exit 1
  fi
  echo ""
else
  echo "ERROR: verify-update not found or not executable." >&2
  echo "       Expected: $CAULDRON_DIR/verify-update" >&2
  echo "       Use --skip-preflight to bypass (emergency only)." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 4. Stop server and wait for all workers to exit.
# ---------------------------------------------------------------------------
if [ -f "$CAULDRON_DIR/data/cauldron.pid" ]; then
  echo "--> Stopping server..."
  "$CAULDRON_DIR/stop"
fi

# ---------------------------------------------------------------------------
# 5. Back up the database.
# ---------------------------------------------------------------------------
DB="$CAULDRON_DIR/data/cauldron.db"
BACKUP=""
if [ -f "$DB" ]; then
  BACKUP="$CAULDRON_DIR/data/cauldron.db.bak-$(date +%Y%m%d-%H%M%S)"
  cp "$DB" "$BACKUP"
  echo "--> Database backed up to $(basename "$BACKUP")"
fi

# ---------------------------------------------------------------------------
# 6. Record the current commit so rollback can return to it exactly.
# ---------------------------------------------------------------------------
PREV_COMMIT="$(git rev-parse HEAD)"
echo "--> Current commit: ${PREV_COMMIT:0:8}"

# Rollback: restore HEAD, DB, packages, and server on any post-stop failure.
_rollback() {
  echo ""
  echo "!!! Update failed. Rolling back to ${PREV_COMMIT:0:8}..."

  # Stop any partially-started server.
  if [ -f "$CAULDRON_DIR/data/cauldron.pid" ]; then
    "$CAULDRON_DIR/stop" 2>/dev/null || true
  fi

  # Return HEAD and working tree to the previous commit.
  cd "$REPO_DIR"
  git reset --hard "$PREV_COMMIT" 2>/dev/null || true

  # Restore the database backup.
  if [ -n "${BACKUP:-}" ] && [ -f "$BACKUP" ]; then
    cp "$BACKUP" "$DB"
    echo "!!! Database restored from backup."
  fi

  # Reinstall packages from the restored commit and restart.
  source "$VENV/bin/activate"
  install_python_projects "$REPO_DIR" "$CAULDRON_DIR/requirements.txt"
  "$CAULDRON_DIR/start" 2>/dev/null || true

  echo ""
  echo "!!! Cauldron rolled back to commit ${PREV_COMMIT:0:8}."
  echo "!!! Fix the error above, then run ./update again."
}
trap '_rollback' ERR

# ---------------------------------------------------------------------------
# 7. Advance the checkout to the exact verified candidate SHA.
#    Uses a fast-forward merge pinned to CANDIDATE_SHA — not an unpinned pull
#    that could pick up a newer remote commit arriving after preflight.
# ---------------------------------------------------------------------------
if [[ "$HAS_UPSTREAM" -eq 1 && "$PREV_COMMIT" != "$CANDIDATE_SHA" ]]; then
  echo "--> Advancing to verified candidate ${CANDIDATE_SHA:0:8}..."
  cd "$REPO_DIR"
  git merge --ff-only "$CANDIDATE_SHA"
else
  echo "--> Skipping checkout (no upstream or already at ${CANDIDATE_SHA:0:8})."
fi

# ---------------------------------------------------------------------------
# 8. Install/upgrade all Python packages and their dependencies.
# ---------------------------------------------------------------------------
echo "--> Upgrading dependencies..."
source "$VENV/bin/activate"
install_python_projects "$REPO_DIR" "$CAULDRON_DIR/requirements.txt"

# ---------------------------------------------------------------------------
# 9. Run migrations.
# ---------------------------------------------------------------------------
echo "--> Applying database migrations..."
"$CAULDRON_DIR/manage" migrate --no-input

# ---------------------------------------------------------------------------
# 10. Collect static assets.
# ---------------------------------------------------------------------------
echo "--> Collecting static assets..."
"$CAULDRON_DIR/manage" collectstatic --no-input --clear -v 0

# ---------------------------------------------------------------------------
# 11. Initialize override directory.
# ---------------------------------------------------------------------------
"$CAULDRON_DIR/manage" cauldron_ui_init 2>/dev/null || true

# ---------------------------------------------------------------------------
# 12. Install/upgrade frontend dependencies.
# ---------------------------------------------------------------------------
install_frontend "$CAULDRON_DIR"

# ---------------------------------------------------------------------------
# 13. Rebuild public site.
#     A build failure does NOT roll back the Python/database updates — those
#     are safe to keep.  We record the outcome and report it at the end after
#     the server is confirmed healthy.
# ---------------------------------------------------------------------------
echo "--> Building public site..."
SITE_BUILD_OK=1
"$CAULDRON_DIR/manage" cauldron_site_build \
  2>&1 | tee -a "$CAULDRON_DIR/logs/site_build.log" || SITE_BUILD_OK=0
if [ "$SITE_BUILD_OK" -eq 0 ]; then
  echo ""
  echo "    WARNING: Public-site rebuild failed. Existing output was preserved."
  echo "             See: $CAULDRON_DIR/logs/site_build.log"
fi

# ---------------------------------------------------------------------------
# 14. Run system check.
# ---------------------------------------------------------------------------
echo "--> Running system check..."
"$CAULDRON_DIR/manage" check

# ---------------------------------------------------------------------------
# 15. Start server.
# Re-source lib.sh so any changes pulled in step 7 take effect before the
# server is launched.
# ---------------------------------------------------------------------------
echo "--> Starting server..."
source "$CAULDRON_DIR/lib.sh"
PORT="${CAULDRON_PORT:-8000}"
launch_server "$CAULDRON_DIR" "$PORT"

# ---------------------------------------------------------------------------
# 16. Health check — verify the app and static files are reachable.
#     Triggers the ERR trap (and therefore rollback) on failure.
# ---------------------------------------------------------------------------
HEALTH_HOST="${CAULDRON_HOST:-0.0.0.0}"
[ "$HEALTH_HOST" = "0.0.0.0" ] && HEALTH_HOST="127.0.0.1"
echo "--> Verifying server health..."
HEALTHY=0
for i in $(seq 1 20); do
  if curl -sf "http://$HEALTH_HOST:$PORT/accounts/login/" -o /dev/null 2>/dev/null && \
     curl -sf "http://$HEALTH_HOST:$PORT/static/cauldron_admin/css/tokens.css" -o /dev/null 2>/dev/null; then
    HEALTHY=1
    break
  fi
  sleep 1
done

if [ "$HEALTHY" -eq 0 ]; then
  echo "ERROR: Server did not respond on port $PORT after 20 seconds."
  false  # Triggers the ERR trap → _rollback
fi

trap - ERR

NEW_COMMIT="$(git -C "$REPO_DIR" rev-parse --short HEAD)"

# Report final status.
if [ "$SITE_BUILD_OK" -eq 0 ]; then
  echo ""
  echo "==> Application updated; public-site rebuild failed."
  echo "    Retry:     ./manage cauldron_site_build"
  echo "    Build log: $CAULDRON_DIR/logs/site_build.log"
  echo "    ${PREV_COMMIT:0:8} -> $NEW_COMMIT"
  exit 1
fi

echo ""
echo "==> Cauldron updated successfully."
echo "    ${PREV_COMMIT:0:8} -> $NEW_COMMIT"

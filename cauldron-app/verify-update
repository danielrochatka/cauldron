#!/usr/bin/env bash
# verify-update — Verify a Cauldron ref installs, migrates, and serves cleanly.
#
# Does NOT touch the live checkout, live virtualenv, live database, PID files,
# generated public output, or any running server.  All work happens inside a
# temporary Git worktree and a temporary Python virtualenv that are removed on
# exit, regardless of success or failure.
#
# Usage
# -----
#   ./verify-update [--wheelhouse DIR] [REF]
#   ./verify-update [--wheelhouse DIR] --from-ref OLD --to-ref NEW
#
# REF defaults to HEAD when omitted.
# --from-ref and --to-ref must both be supplied together.
#
# Options
# -------
#   --wheelhouse DIR   Use pre-built wheels from DIR instead of building from
#                      source.  When provided, wheels are installed rather than
#                      editable source installs.  For upgrade mode this
#                      wheelhouse applies to TO_REF; FROM_REF is always built
#                      from source to simulate a real upgrade.
#
# Environment
# -----------
#   VERIFY_ARTIFACT_DIR   When set, logs and the phase report are copied here
#                         before the temporary worktree is removed.  Useful for
#                         uploading CI artifacts on failure.
#
# Exit codes
# ----------
#   0  all phases passed
#   1  at least one phase failed
#   2  usage error

set -euo pipefail

CAULDRON_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$CAULDRON_DIR")"
source "$CAULDRON_DIR/lib.sh"

# Use BASH_SOURCE[0] so the path resolves correctly when this script is sourced
# (e.g. by tests). $0 changes when sourced but BASH_SOURCE[0] does not.
_VERIFY_UPDATE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_VERIFY_WHEELS_PY="$_VERIFY_UPDATE_DIR/../tools/verify_wheels.py"

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

FROM_REF=""
TO_REF=""
CLEAN_REF="HEAD"
WHEELHOUSE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from-ref)   FROM_REF="$2";    shift 2 ;;
    --to-ref)     TO_REF="$2";      shift 2 ;;
    --wheelhouse) WHEELHOUSE="$2";  shift 2 ;;
    --help|-h)
      sed -n '2,/^[^#]/p' "$0" | grep '^#' | sed 's/^# \?//'
      exit 0
      ;;
    -*)
      echo "ERROR: Unknown option: $1" >&2
      echo "       Run: $0 --help" >&2
      exit 2
      ;;
    *) CLEAN_REF="$1"; shift ;;
  esac
done

UPGRADE_MODE=0
if [[ -n "$FROM_REF" || -n "$TO_REF" ]]; then
  if [[ -z "$FROM_REF" || -z "$TO_REF" ]]; then
    echo "ERROR: --from-ref and --to-ref must both be specified together." >&2
    exit 2
  fi
  UPGRADE_MODE=1
fi

# ---------------------------------------------------------------------------
# Phase tracking
# ---------------------------------------------------------------------------

declare -a _PHASE_LOG=()
_OVERALL_OK=1

_phase() {
  echo ""
  echo "--> [$1]"
}

_pass() { _PHASE_LOG+=("  PASS  $1"); }
_fail() { _PHASE_LOG+=("  FAIL  $1"); _OVERALL_OK=0; }
_skip() { _PHASE_LOG+=("  SKIP  $1"); }

_print_report() {
  echo ""
  echo "==> Verification report"
  for line in "${_PHASE_LOG[@]}"; do
    echo "    $line"
  done
  echo ""
}

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

_VERIFY_WORKTREE=""
_VERIFY_SERVER_PID=""

_cleanup() {
  local exit_status=$?

  # If the script exited with a non-zero status but no _fail() was recorded
  # (e.g. an unexpected exit inside a helper), treat it as a failure.
  if [[ "$exit_status" -ne 0 && "${_OVERALL_OK}" -eq 1 ]]; then
    _OVERALL_OK=0
  fi

  # Stop the temporary server if it is still running.
  if [[ -n "${_VERIFY_SERVER_PID:-}" ]] && kill -0 "$_VERIFY_SERVER_PID" 2>/dev/null; then
    kill "$_VERIFY_SERVER_PID" 2>/dev/null || true
    wait "$_VERIFY_SERVER_PID" 2>/dev/null || true
  fi

  # Preserve diagnostics before removing the worktree.
  # refs.txt and report.txt are always written when VERIFY_ARTIFACT_DIR is set,
  # even when the worktree was never created (e.g. failed ref resolution).
  if [[ -n "${VERIFY_ARTIFACT_DIR:-}" ]]; then
    mkdir -p "$VERIFY_ARTIFACT_DIR"
    {
      echo "CLEAN_REF=${CLEAN_REF:-}"
      echo "FROM_REF=${FROM_REF:-}"
      echo "TO_REF=${TO_REF:-}"
      echo "WHEELHOUSE=${WHEELHOUSE:-}"
    } > "$VERIFY_ARTIFACT_DIR/refs.txt"
    {
      echo "==> Verification report"
      for line in "${_PHASE_LOG[@]}"; do
        echo "    $line"
      done
    } > "$VERIFY_ARTIFACT_DIR/report.txt"
    # Copy server/build logs if the worktree was created.
    if [[ -n "${_VERIFY_WORKTREE:-}" && -d "${_VERIFY_WORKTREE:-}" ]]; then
      local app_logs="$_VERIFY_WORKTREE/cauldron-app/logs"
      if [[ -d "$app_logs" ]]; then
        cp -a "$app_logs/." "$VERIFY_ARTIFACT_DIR/" 2>/dev/null || true
      fi
    fi
  fi

  # Remove the temporary worktree (also removes its .venv, data/, and built wheels).
  if [[ -n "${_VERIFY_WORKTREE:-}" && -d "${_VERIFY_WORKTREE:-}" ]]; then
    git -C "$REPO_DIR" worktree remove --force "$_VERIFY_WORKTREE" 2>/dev/null \
      || rm -rf "$_VERIFY_WORKTREE"
    git -C "$REPO_DIR" worktree prune 2>/dev/null || true
  fi

  _print_report

  if [[ "${_OVERALL_OK}" -eq 1 ]]; then
    echo "==> Verification PASSED."
    exit 0
  else
    echo "==> Verification FAILED (see report above)."
    exit 1
  fi
}

# Register the EXIT trap only when executing as a script (not when sourced by
# tests that need to call individual functions).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  trap '_cleanup' EXIT
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_find_free_port() {
  python3 -c "
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.bind(('127.0.0.1', 0))
port = s.getsockname()[1]
s.close()
print(port)
"
}

_resolve_ref() {
  local ref="$1"
  local sha
  if ! sha=$(git -C "$REPO_DIR" rev-parse --verify "${ref}^{commit}" 2>/dev/null); then
    echo "ERROR: Cannot resolve Git ref: ${ref}" >&2
    exit 1
  fi
  echo "$sha"
}

# ---------------------------------------------------------------------------
# Wheel helpers
# ---------------------------------------------------------------------------

# Build distribution wheels for every first-party Python package in WORKTREE
# into WHEELHOUSE_DIR, then generate manifest.json with per-wheel sha256
# digests bound to SOURCE_SHA.
_build_wheels() {
  local worktree="$1"
  local wheelhouse_dir="$2"
  local source_sha="$3"
  local venv_python="$worktree/.venv/bin/python"
  local venv_pip="$worktree/.venv/bin/pip"
  local build_log="$worktree/cauldron-app/logs/pip-build.log"

  mkdir -p "$wheelhouse_dir"

  # Install build frontend only; each project's build backend is installed in
  # an isolated environment by python -m build (PEP 517, no --no-isolation).
  "$venv_pip" install -q build

  # Build root cauldron package.
  "$venv_python" -m build --wheel \
    --outdir "$wheelhouse_dir" \
    "$worktree" \
    >> "$build_log" 2>&1 || return 1

  # Build each sub-package.
  for pkg in "$worktree/packages"/*/; do
    [[ -f "${pkg}pyproject.toml" ]] || continue
    "$venv_python" -m build --wheel \
      --outdir "$wheelhouse_dir" \
      "$pkg" \
      >> "$build_log" 2>&1 || return 1
  done

  # Record source SHA and per-wheel digests so verify-update can confirm the
  # wheelhouse was built from the exact ref being verified.
  python3 "$_VERIFY_WHEELS_PY" generate-manifest \
    --wheelhouse "$wheelhouse_dir" \
    --source-sha "$source_sha" \
    >> "$build_log" 2>&1
}

# Verify that each wheel in WHEELHOUSE_DIR contains the required artifacts.
# When REQUIRE_SHA is non-empty, also validates manifest.json source_sha and
# per-wheel sha256 digests (requires _build_wheels to have generated the manifest).
_verify_wheel_contents() {
  local wheelhouse_dir="$1"
  local label="${2:-}"
  local require_sha="${3:-}"
  local repo_root="${4:-}"
  local all_ok=1

  local extra_args=()
  [[ -n "$require_sha" ]] && extra_args+=(--require-sha "$require_sha")
  [[ -n "$repo_root" ]]   && extra_args+=(--repo-root   "$repo_root")

  local output exit_code
  output=$(python3 "$_VERIFY_WHEELS_PY" verify \
    --wheelhouse "$wheelhouse_dir" "${extra_args[@]}" 2>&1)
  exit_code=$?

  # Parse per-wheel result lines emitted by verify_wheels.py.
  # Format: "OK    <label>: <detail>" or "FAIL  <label>: <detail>" (6-char prefix)
  local parsed=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local status="" pkg_label="" detail="" rest=""
    if [[ "$line" == "OK    "* ]]; then
      status="OK"
      rest="${line:6}"
      pkg_label="${rest%%:*}"
      detail="${rest#*: }"
    elif [[ "$line" == "FAIL  "* ]]; then
      status="FAIL"
      rest="${line:6}"
      pkg_label="${rest%%:*}"
      detail="${rest#*: }"
    else
      continue
    fi
    _phase "${label}wheel:${pkg_label}"
    if [[ "$status" == "OK" ]]; then
      _pass "${label}wheel:${pkg_label} — ${detail}"
    else
      _fail "${label}wheel:${pkg_label} — ${detail}"
      all_ok=0
    fi
    parsed=1
  done <<< "$output"

  # If verify_wheels.py exited non-zero but produced no parseable per-wheel
  # lines (e.g. manifest SHA mismatch or empty wheelhouse), surface the error.
  if [[ "$exit_code" -ne 0 && "$parsed" -eq 0 ]]; then
    _fail "${label}wheel validation: ${output}"
    all_ok=0
  fi

  [[ "$all_ok" -eq 1 ]]
}

# Install all Python packages into WORKTREE/.venv from either:
#   (a) a pre-built wheelhouse (when WHEELHOUSE arg is non-empty), or
#   (b) editable source installs from the worktree.
#
# In both cases a single pip invocation is used so that pip can resolve
# first-party packages (including cauldron-site-astro, which is listed in
# requirements.txt) from the provided wheels or editable paths rather than
# attempting a PyPI download.
_install_packages() {
  local worktree="$1"
  local wheelhouse="${2:-}"
  local venv_pip="$worktree/.venv/bin/pip"
  local req="$worktree/cauldron-app/requirements.txt"
  local pip_log="$worktree/cauldron-app/logs/pip-install.log"

  if [[ -n "$wheelhouse" ]]; then
    local whl_files=("$wheelhouse"/*.whl)
    if [[ ${#whl_files[@]} -eq 0 || ! -f "${whl_files[0]}" ]]; then
      _fail "packages: no wheels found in wheelhouse ${wheelhouse}"
      return 1
    fi
    # Single invocation: pip satisfies requirements.txt AND first-party wheels
    # together, so packages like cauldron-site-astro resolve from the wheelhouse
    # instead of PyPI.
    if ! "$venv_pip" install -q -r "$req" "${whl_files[@]}" >> "$pip_log" 2>&1; then
      _fail "package installation failed"
      return 1
    fi
  else
    # Editable installs from source — single invocation covers the root package
    # and every sub-package so cross-dependency resolution works in one pass.
    local args=(-q -r "$req" -e "$worktree")
    for pkg in "$worktree/packages"/*/; do
      [[ -f "${pkg}pyproject.toml" ]] || continue
      args+=(-e "$pkg")
    done
    if ! "$venv_pip" install "${args[@]}" >> "$pip_log" 2>&1; then
      _fail "package installation failed"
      return 1
    fi
  fi
}

# ---------------------------------------------------------------------------
# Phase runner: prepare a worktree at a given ref
# ---------------------------------------------------------------------------

_setup_worktree() {
  local ref="$1"
  local worktree="$2"
  local wheelhouse="${3:-}"

  _phase "worktree"
  local sha
  sha=$(_resolve_ref "$ref")
  git -C "$REPO_DIR" worktree add --detach "$worktree" "$sha"
  _pass "worktree created at ${sha:0:8}"

  local app_dir="$worktree/cauldron-app"

  _phase "venv"
  python3 -m venv "$worktree/.venv"
  "$worktree/.venv/bin/pip" install --upgrade pip -q
  _pass "virtualenv created"

  # Ensure logs dir exists before any installs write to it.
  mkdir -p "$app_dir/logs"

  if [[ -n "$wheelhouse" ]]; then
    # Verify wheel contents and confirm the manifest was built from this SHA.
    _verify_wheel_contents "$wheelhouse" "" "$sha" "$worktree"
  else
    # Build wheels from source, then verify their contents.
    _phase "wheel:build"
    if _build_wheels "$worktree" "$worktree/.wheelhouse" "$sha"; then
      _pass "wheels built from ${sha:0:8}"
    else
      _fail "wheel build failed at ${sha:0:8}"
      return 1
    fi
    _verify_wheel_contents "$worktree/.wheelhouse" "" "" "$worktree"
    wheelhouse="$worktree/.wheelhouse"
  fi

  _phase "packages"
  if ! _install_packages "$worktree" "$wheelhouse"; then
    return 1
  fi
  _pass "packages installed (${sha:0:8})"

  _phase "config"
  mkdir -p \
    "$app_dir/data/workspace" \
    "$app_dir/data/ai" \
    "$app_dir/data/public" \
    "$app_dir/data/previews" \
    "$app_dir/staticfiles"
  initialize_config "$app_dir/config.env" "$app_dir/config.env.example"
  _pass "config initialized"
}

# ---------------------------------------------------------------------------
# Phase runner: Django management commands
# ---------------------------------------------------------------------------

_run_django_phases() {
  local worktree="$1"
  local label="${2:-}"
  local app_dir="$worktree/cauldron-app"
  local python="$worktree/.venv/bin/python"

  # Export config env vars so settings.py can read them.
  # Always override CAULDRON_HOST to 127.0.0.1 so the verify server and
  # health-check URLs are on the same address.
  set -a
  # shellcheck source=/dev/null
  source "$app_dir/config.env"
  CAULDRON_HOST=127.0.0.1
  set +a

  # ---- system check -------------------------------------------------------
  _phase "${label}check"
  if "$python" "$app_dir/manage.py" check 2>&1; then
    _pass "${label}manage.py check"
  else
    _fail "${label}manage.py check"
    return 1
  fi

  # ---- migration check (no unapplied schema changes) ----------------------
  _phase "${label}makemigrations --check"
  if "$python" "$app_dir/manage.py" makemigrations --check --dry-run 2>&1; then
    _pass "${label}no pending migrations"
  else
    _fail "${label}pending migrations detected"
    return 1
  fi

  # ---- apply migrations ---------------------------------------------------
  _phase "${label}migrate"
  if "$python" "$app_dir/manage.py" migrate --no-input 2>&1; then
    _pass "${label}migrations applied"
  else
    _fail "${label}migration failed"
    return 1
  fi

  # ---- static assets ------------------------------------------------------
  _phase "${label}collectstatic"
  if "$python" "$app_dir/manage.py" collectstatic --no-input --clear -v 0 2>&1; then
    _pass "${label}static files collected"
  else
    _fail "${label}collectstatic failed"
    return 1
  fi

  # ---- frontend + site build ----------------------------------------------
  # When frontend/package.json exists, Node/npm/Astro are required and a
  # build failure is a hard error.  When no frontend is configured the phase
  # is skipped with SKIP (not PASS) so the distinction is visible in the report.
  _phase "${label}cauldron_site_build"
  local app_frontend="$app_dir/frontend"
  if [[ ! -f "$app_frontend/package.json" ]]; then
    _skip "${label}site build (no frontend/package.json)"
  else
    if ! check_node_version 18 2>&1; then
      _fail "${label}Node.js ≥18 required for frontend but not found"
      return 1
    fi
    if ! install_frontend "$app_dir" 2>&1; then
      _fail "${label}frontend installation failed"
      return 1
    fi
    if ! "$python" "$app_dir/manage.py" cauldron_site_build 2>&1; then
      _fail "${label}site build failed"
      return 1
    fi
    _pass "${label}site build succeeded"
  fi
}

# ---------------------------------------------------------------------------
# Phase runner: server startup and HTTP health
# ---------------------------------------------------------------------------

_run_server_phases() {
  local worktree="$1"
  local label="${2:-}"
  local app_dir="$worktree/cauldron-app"
  local python="$worktree/.venv/bin/python"

  set -a
  # shellcheck source=/dev/null
  source "$app_dir/config.env"
  # Pin the verify server to 127.0.0.1 regardless of production config.
  CAULDRON_HOST=127.0.0.1
  set +a

  local port
  port=$(_find_free_port)
  local srv_log="$app_dir/logs/verify-server.log"

  _phase "${label}server startup"
  CAULDRON_HOST=127.0.0.1 \
  "$python" "$app_dir/manage.py" \
    runserver "127.0.0.1:$port" --nothreading --noreload \
    >"$srv_log" 2>&1 &
  _VERIFY_SERVER_PID=$!

  # Poll until the server responds, the process exits, or the timeout expires.
  local healthy=0
  for _ in $(seq 1 30); do
    # Detect immediate crash — fail without waiting the full 30 s.
    if ! kill -0 "$_VERIFY_SERVER_PID" 2>/dev/null; then
      echo "" >&2
      echo "    Server process exited unexpectedly.  Log:" >&2
      sed 's/^/    /' "$srv_log" >&2 2>/dev/null || true
      _fail "${label}server process exited before accepting connections"
      _VERIFY_SERVER_PID=""
      return 1
    fi
    if curl -sf "http://127.0.0.1:${port}/accounts/login/" -o /dev/null 2>/dev/null; then
      healthy=1
      break
    fi
    sleep 1
  done

  if [[ "$healthy" -eq 0 ]]; then
    echo "" >&2
    echo "    Server did not respond within 30 s.  Log:" >&2
    sed 's/^/    /' "$srv_log" >&2 2>/dev/null || true
    _fail "${label}server did not respond on port ${port} within 30 s"
    kill "$_VERIFY_SERVER_PID" 2>/dev/null || true
    wait "$_VERIFY_SERVER_PID" 2>/dev/null || true
    _VERIFY_SERVER_PID=""
    return 1
  fi
  _pass "${label}server started on port ${port}"

  # ---- HTTP health checks -------------------------------------------------
  _phase "${label}health"
  local health_ok=1

  if curl -sf "http://127.0.0.1:${port}/accounts/login/" -o /dev/null 2>/dev/null; then
    _pass "${label}/accounts/login/ → 200"
  else
    _fail "${label}/accounts/login/ did not respond"
    health_ok=0
  fi

  if curl -sf \
    "http://127.0.0.1:${port}/static/cauldron_admin/css/tokens.css" \
    -o /dev/null 2>/dev/null; then
    _pass "${label}/static/cauldron_admin/css/tokens.css → 200"
  else
    _fail "${label}/static/cauldron_admin/css/tokens.css not found"
    health_ok=0
  fi

  # Stop the temporary server before returning.
  kill "$_VERIFY_SERVER_PID" 2>/dev/null || true
  wait "$_VERIFY_SERVER_PID" 2>/dev/null || true
  _VERIFY_SERVER_PID=""

  [[ "$health_ok" -eq 1 ]]
}

# ---------------------------------------------------------------------------
# Clean-install verification
# ---------------------------------------------------------------------------

_run_clean_install() {
  local ref="${1:-HEAD}"
  local sha
  sha=$(_resolve_ref "$ref")
  echo "==> Cauldron verify-update  (clean install: ${sha:0:8})"
  echo "    Repository: $REPO_DIR"
  [[ -n "$WHEELHOUSE" ]] && echo "    Wheelhouse: $WHEELHOUSE"
  echo ""

  _VERIFY_WORKTREE="$(mktemp -d /tmp/cauldron-verify-XXXXXX)"
  _setup_worktree "$ref" "$_VERIFY_WORKTREE" "$WHEELHOUSE"
  _run_django_phases "$_VERIFY_WORKTREE" ""
  _run_server_phases "$_VERIFY_WORKTREE" ""
}

# ---------------------------------------------------------------------------
# Upgrade-path verification
# ---------------------------------------------------------------------------

_run_upgrade_path() {
  local from_ref="$1"
  local to_ref="$2"
  local from_sha to_sha
  from_sha=$(_resolve_ref "$from_ref")
  to_sha=$(_resolve_ref "$to_ref")
  echo "==> Cauldron verify-update  (upgrade: ${from_sha:0:8} → ${to_sha:0:8})"
  echo "    Repository:  $REPO_DIR"
  echo "    From commit: ${from_sha}"
  echo "    To commit:   ${to_sha}"
  [[ -n "$WHEELHOUSE" ]] && echo "    To wheelhouse: $WHEELHOUSE"
  echo ""

  _VERIFY_WORKTREE="$(mktemp -d /tmp/cauldron-verify-XXXXXX)"
  local app_dir="$_VERIFY_WORKTREE/cauldron-app"
  local python="$_VERIFY_WORKTREE/.venv/bin/python"

  # 1. Install and initialise the from-ref (always from source for upgrade base).
  _setup_worktree "$from_ref" "$_VERIFY_WORKTREE" ""
  _run_django_phases "$_VERIFY_WORKTREE" "[from] "

  # 2. Create representative persisted state.
  _phase "[from] state:create"
  set -a; source "$app_dir/config.env"; CAULDRON_HOST=127.0.0.1; set +a
  if ! "$python" "$app_dir/manage.py" shell -c "
from django.contrib.auth import get_user_model
User = get_user_model()
if not User.objects.filter(username='verify-upgrade-user').exists():
    User.objects.create_superuser('verify-upgrade-user', 'verify@localhost', 'verify-pw-1!')
    print('created superuser verify-upgrade-user')
else:
    print('superuser already exists')
" 2>&1; then
    _fail "[from] representative state creation failed"
    return 1
  fi
  _pass "[from] representative state created (superuser)"

  # 3. Check out to-ref in the same worktree.
  _phase "[to] upgrade:worktree"
  git -C "$_VERIFY_WORKTREE" checkout --detach "$to_sha" 2>/dev/null
  _pass "[to] checked out ${to_sha:0:8}"

  # 4. Build (or use provided) wheelhouse for to-ref and verify contents.
  local to_wheelhouse
  if [[ -n "$WHEELHOUSE" ]]; then
    to_wheelhouse="$WHEELHOUSE"
    _verify_wheel_contents "$to_wheelhouse" "[to] " "$to_sha" "$_VERIFY_WORKTREE"
  else
    _phase "[to] wheel:build"
    to_wheelhouse="$_VERIFY_WORKTREE/.wheelhouse-to"
    if _build_wheels "$_VERIFY_WORKTREE" "$to_wheelhouse" "$to_sha"; then
      _pass "[to] wheels built from ${to_sha:0:8}"
    else
      _fail "[to] wheel build failed at ${to_sha:0:8}"
      return 1
    fi
    _verify_wheel_contents "$to_wheelhouse" "[to] " "" "$_VERIFY_WORKTREE"
  fi

  # 5. Install to-ref packages (force-reinstall to replace from-ref versions).
  _phase "[to] upgrade:packages"
  local venv_pip="$_VERIFY_WORKTREE/.venv/bin/pip"
  local pip_log="$app_dir/logs/pip-install-upgrade.log"
  local whl_files=("$to_wheelhouse"/*.whl)
  if [[ ${#whl_files[@]} -gt 0 && -f "${whl_files[0]}" ]]; then
    if ! "$venv_pip" install -q --force-reinstall "${whl_files[@]}" \
        >> "$pip_log" 2>&1; then
      _fail "[to] package upgrade failed"
      return 1
    fi
  else
    local args=(-q -e "$_VERIFY_WORKTREE")
    for pkg in "$_VERIFY_WORKTREE/packages"/*/; do
      [[ -f "${pkg}pyproject.toml" ]] || continue
      args+=(-e "$pkg")
    done
    if ! "$venv_pip" install "${args[@]}" >> "$pip_log" 2>&1; then
      _fail "[to] package upgrade failed"
      return 1
    fi
  fi
  _pass "[to] packages upgraded to ${to_sha:0:8}"

  # 6. Run Django phases on the upgraded installation (same data/ directory).
  _run_django_phases "$_VERIFY_WORKTREE" "[to] "

  # 7. Verify representative state is readable after upgrade.
  _phase "[to] state:verify"
  set -a; source "$app_dir/config.env"; CAULDRON_HOST=127.0.0.1; set +a
  local count
  if ! count=$("$python" "$app_dir/manage.py" shell -c "
from django.contrib.auth import get_user_model
print(get_user_model().objects.filter(username='verify-upgrade-user').count())
" 2>&1 | tail -1); then
    _fail "[to] state verification command failed"
    return 1
  fi

  if [[ "${count}" == "1" ]]; then
    _pass "[to] representative state readable after upgrade"
  else
    _fail "[to] representative state lost after upgrade (count=${count})"
    return 1
  fi

  # 8. Server health on the upgraded installation.
  _run_server_phases "$_VERIFY_WORKTREE" "[to] "
}

# ---------------------------------------------------------------------------
# Dispatch (only when executed as a script, not when sourced)
